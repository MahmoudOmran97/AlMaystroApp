<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="AlMaystroApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:v="clr-namespace:AlMaystroApp.Views"
       FlowDirection="RightToLeft" Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="login" ContentTemplate="{DataTemplate v:LoginPage}" Shell.NavBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent Route="categories" Title="الأقسام"   ContentTemplate="{DataTemplate v:CategoriesPage}" />
        <ShellContent Route="bookings"   Title="الحجوزات" ContentTemplate="{DataTemplate v:BookingsPage}" />
    </TabBar>
</Shell>
