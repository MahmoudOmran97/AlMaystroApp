<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AlMaystroApp.Controls"
             x:Class="AlMaystroApp.Pages.DashboardPage"
             BackgroundColor="#111111">

	<Shell.TitleView>
		<Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="15,0,15,0" HeightRequest="50">
			<Label Grid.Column="0" Text="✂" FontSize="22" TextColor="#CC2200"
                   VerticalOptions="Center" Margin="0,0,12,0"/>
			<StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="-2">
				<Label Text="ALMAYSTRO" FontSize="16" FontAttributes="Bold"
                       TextColor="#F5F0EB" FontFamily="Cairo" CharacterSpacing="1.2"/>
				<Label x:Name="lblDate" FontSize="10" TextColor="#B0A8A0"
                       FontFamily="Cairo" Margin="2,0,0,0"/>
			</StackLayout>
			<Frame x:Name="btnManage" Grid.Column="2" Padding="0"
                   HeightRequest="36" WidthRequest="36" CornerRadius="18"
                   BackgroundColor="#1A1A1A" BorderColor="#333333"
                   HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,8,0">
				<Frame.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnManageTapped"/>
				</Frame.GestureRecognizers>
				<Label Text="⚙" TextColor="#C9A84C" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
			</Frame>
			<Frame x:Name="btnRefresh" Grid.Column="3" Padding="0"
                   HeightRequest="36" WidthRequest="36" CornerRadius="18"
                   BackgroundColor="#1A1A1A" BorderColor="#333333"
                   HorizontalOptions="End" VerticalOptions="Center">
				<Frame.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnRefreshClicked"/>
				</Frame.GestureRecognizers>
				<Label Text="↻" TextColor="#CC2200" FontSize="20"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,2"/>
			</Frame>
		</Grid>
	</Shell.TitleView>

	<Grid>
		<RefreshView x:Name="refreshView" Refreshing="OnRefreshing" RefreshColor="#CC2200">
			<ScrollView>
				<VerticalStackLayout Padding="14,14,14,100" Spacing="14">

					<Frame x:Name="errFrame" IsVisible="False"
                           BackgroundColor="#2A0800" BorderColor="#550F00"
                           CornerRadius="10" Padding="12,8">
						<Label x:Name="lblErr" TextColor="#FF6644" FontSize="12" FontFamily="Cairo"/>
					</Frame>

					<ActivityIndicator x:Name="loader" IsRunning="True" IsVisible="True"
                                       Color="#CC2200" HeightRequest="40"/>

					<Grid x:Name="statsGrid" IsVisible="False"
                          ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="10" RowSpacing="10">
						<Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#1A1A1A"
                               BorderColor="#333333" CornerRadius="14" Padding="14">
							<VerticalStackLayout Spacing="4">
								<Label Text="🧾" FontSize="22"/>
								<Label x:Name="lblCount" Text="–" FontSize="26"
                                       FontAttributes="Bold" TextColor="#F5F0EB" FontFamily="Cairo"/>
								<Label Text="فواتير اليوم" FontSize="11"
                                       TextColor="#B0A8A0" FontFamily="Cairo"/>
							</VerticalStackLayout>
						</Frame>
						<Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#1A1A1A"
                               BorderColor="#CC2200" CornerRadius="14" Padding="14">
							<VerticalStackLayout Spacing="4">
								<Label Text="💰" FontSize="22"/>
								<Label x:Name="lblPaid" Text="–" FontSize="22"
                                       FontAttributes="Bold" TextColor="#CC2200" FontFamily="Cairo"/>
								<Label Text="المحصّل" FontSize="11"
                                       TextColor="#B0A8A0" FontFamily="Cairo"/>
							</VerticalStackLayout>
						</Frame>
						<Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#1A1A1A"
                               BorderColor="#333333" CornerRadius="14" Padding="14">
							<VerticalStackLayout Spacing="4">
								<Label Text="📈" FontSize="22"/>
								<Label x:Name="lblRev" Text="–" FontSize="22"
                                       FontAttributes="Bold" TextColor="#F5F0EB" FontFamily="Cairo"/>
								<Label Text="صافي الدخل" FontSize="11"
                                       TextColor="#B0A8A0" FontFamily="Cairo"/>
							</VerticalStackLayout>
						</Frame>
						<Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#2A0800"
                               BorderColor="#550F00" CornerRadius="14" Padding="14">
							<VerticalStackLayout Spacing="4">
								<Label Text="⏳" FontSize="22"/>
								<Label x:Name="lblUnpaid" Text="–" FontSize="22"
                                       FontAttributes="Bold" TextColor="#FF6644" FontFamily="Cairo"/>
								<Label Text="غير محصّل" FontSize="11"
                                       TextColor="#B0A8A0" FontFamily="Cairo"/>
							</VerticalStackLayout>
						</Frame>
					</Grid>

					<Frame x:Name="finCard" IsVisible="False" BackgroundColor="#1A1A1A"
                           BorderColor="#CC2200" CornerRadius="14" Padding="16">
						<VerticalStackLayout Spacing="12">
							<Grid ColumnDefinitions="Auto,*">
								<BoxView Grid.Column="0" Color="#CC2200" WidthRequest="4"
                                         CornerRadius="2" Margin="0,0,10,0"/>
								<Label Grid.Column="1" Text="ملخص مالي" FontSize="13"
                                       FontAttributes="Bold" TextColor="#F5F0EB" FontFamily="Cairo"/>
							</Grid>
							<BoxView HeightRequest="1" Color="#333333"/>
							<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="16" RowSpacing="12">
								<VerticalStackLayout Grid.Row="0" Grid.Column="0">
									<Label Text="إجمالي الفواتير" FontSize="11"
                                           TextColor="#606060" FontFamily="Cairo"/>
									<Label x:Name="fTotal" Text="–" FontSize="18"
                                           FontAttributes="Bold" TextColor="#F5F0EB" FontFamily="Cairo"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Row="0" Grid.Column="1">
									<Label Text="المحصّل فعلاً" FontSize="11"
                                           TextColor="#606060" FontFamily="Cairo"/>
									<Label x:Name="fPaid" Text="–" FontSize="18"
                                           FontAttributes="Bold" TextColor="#CC2200" FontFamily="Cairo"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Row="1" Grid.Column="0">
									<Label Text="الدخل الصافي" FontSize="11"
                                           TextColor="#606060" FontFamily="Cairo"/>
									<Label x:Name="fRev" Text="–" FontSize="18"
                                           FontAttributes="Bold" TextColor="#F5F0EB" FontFamily="Cairo"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Row="1" Grid.Column="1">
									<Label Text="الغير محصّل" FontSize="11"
                                           TextColor="#606060" FontFamily="Cairo"/>
									<Label x:Name="fUnpaid" Text="–" FontSize="18"
                                           FontAttributes="Bold" TextColor="#FF6644" FontFamily="Cairo"/>
								</VerticalStackLayout>
							</Grid>
						</VerticalStackLayout>
					</Frame>

					<VerticalStackLayout x:Name="recentSection" IsVisible="False" Spacing="8">
						<Grid ColumnDefinitions="Auto,*">
							<BoxView Grid.Column="0" Color="#CC2200" WidthRequest="4"
                                     HeightRequest="20" CornerRadius="2"
                                     Margin="0,0,8,0" VerticalOptions="Center"/>
							<Label Grid.Column="1" Text="آخر الفواتير" FontSize="13"
                                   FontAttributes="Bold" TextColor="#F5F0EB"
                                   FontFamily="Cairo" VerticalOptions="Center"/>
						</Grid>
						<CollectionView x:Name="recentList" SelectionMode="None">
							<CollectionView.ItemTemplate>
								<DataTemplate>
									<Frame BackgroundColor="#1A1A1A" BorderColor="#333333"
                                           CornerRadius="12" Padding="12" Margin="0,0,0,6">
										<Grid ColumnDefinitions="Auto,*,Auto">
											<Frame Grid.Column="0" BackgroundColor="#2A0800"
                                                   BorderColor="#CC2200" CornerRadius="10"
                                                   Padding="0" WidthRequest="42" HeightRequest="42">
												<Label Text="{Binding Initial}" FontSize="16"
                                                       FontAttributes="Bold" TextColor="#CC2200"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
											</Frame>
											<VerticalStackLayout Grid.Column="1" Margin="10,0"
                                                                 VerticalOptions="Center" Spacing="2">
												<Label Text="{Binding CusName}" FontSize="14"
                                                       FontAttributes="Bold" TextColor="#F5F0EB"
                                                       FontFamily="Cairo"/>
												<Label Text="{Binding SubInfo}" FontSize="12"
                                                       TextColor="#B0A8A0" FontFamily="Cairo"/>
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="2" VerticalOptions="Center"
                                                                 HorizontalOptions="End" Spacing="2">
												<Label Text="{Binding PayFmt}" FontSize="14"
                                                       FontAttributes="Bold" TextColor="#CC2200"
                                                       FontFamily="Cairo" HorizontalOptions="End"/>
												<Label Text="{Binding Time}" FontSize="11"
                                                       TextColor="#606060" FontFamily="Cairo"
                                                       HorizontalOptions="End"/>
											</VerticalStackLayout>
										</Grid>
									</Frame>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
					</VerticalStackLayout>

				</VerticalStackLayout>
			</ScrollView>
		</RefreshView>

		<controls:FloatingTabBar VerticalOptions="End" ActiveTab="Home"/>
	</Grid>
</ContentPage>