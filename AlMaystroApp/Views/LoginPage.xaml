<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlMaystroApp.Views.LoginPage" Title="تسجيل الدخول" FlowDirection="RightToLeft">
    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
        <Label Text="المايسترو" FontSize="30" HorizontalOptions="Center" />
        <Entry Placeholder="اسم المستخدم" Text="{Binding Username}" />
        <Entry Placeholder="كلمة السر" IsPassword="True" Text="{Binding Password}" />
        <Label Text="{Binding Error}" TextColor="Red" />
        <Button Text="دخول" Command="{Binding LoginCommand}" IsEnabled="{Binding NotBusy}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" />
    </VerticalStackLayout>
</ContentPage>
