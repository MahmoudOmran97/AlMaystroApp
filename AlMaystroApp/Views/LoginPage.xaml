<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlMaystroApp.Views.LoginPage"
             Title="تسجيل الدخول"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="16" VerticalOptions="Center">

            <Label Text="✂" FontSize="44" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
            <Label Text="المايسترو" FontSize="30" FontFamily="CairoBold"
                   TextColor="{StaticResource AmberColor}" HorizontalOptions="Center" />
            <Label Text="لوحة الإدارة" FontSize="14" TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center" Margin="0,0,0,12" />

            <Frame>
                <VerticalStackLayout Spacing="12">
                    <Entry Placeholder="اسم المستخدم" Text="{Binding Username}" />
                    <Entry Placeholder="كلمة السر" IsPassword="True" Text="{Binding Password}" />
                    <Label Text="{Binding Error}" TextColor="#FF6644" FontSize="13" />
                    <Button Text="دخول" Command="{Binding LoginCommand}" IsEnabled="{Binding NotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
