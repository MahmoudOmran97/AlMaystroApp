<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:AlMaystroApp.Models"
             xmlns:vm="clr-namespace:AlMaystroApp.ViewModels"
             x:Class="AlMaystroApp.Views.BookingsPage"
             Title="إدارة الحجوزات"
             FlowDirection="RightToLeft">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="فلترة" Command="{Binding FilterCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Padding="14,12" Spacing="12">
            <DatePicker Date="{Binding Day}" IsEnabled="{Binding AllDays, Converter={StaticResource InvertedBool}}" />
            <Label Text="كل الجاي" VerticalOptions="Center" />
            <Switch IsToggled="{Binding AllDays}" OnColor="{StaticResource Primary}" />
        </HorizontalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <Label Text="مفيش حجوزات" HorizontalOptions="Center" Margin="0,40" TextColor="{StaticResource TextSecondary}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:BookingItem">
                        <Frame Margin="14,6" Padding="14,10">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingsViewModel}}, Path=ActionsCommand}" CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                <Label Text="{Binding CustomerName}" FontSize="17" FontFamily="CairoBold" />
                                <Label Grid.Column="1" Text="{Binding StatusAr}" FontFamily="CairoBold" TextColor="{StaticResource AmberColor}" />
                                <Label Grid.Row="1" Text="{Binding ServiceName}" TextColor="{StaticResource TextSecondary}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding SourceAr}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding When}" FontSize="13" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
