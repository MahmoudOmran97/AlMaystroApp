<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:AlMaystroApp.Models"
             xmlns:vm="clr-namespace:AlMaystroApp.ViewModels"
             x:Class="AlMaystroApp.Views.ServicesPage" Title="{Binding Title}" FlowDirection="RightToLeft">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ خدمة" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:ServiceItem">
                    <Grid Padding="14,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontSize="17" />
                            <Label Text="{Binding PriceText}" FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="تعديل" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServicesViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
                        <Button Grid.Column="2" Text="حذف" TextColor="White" BackgroundColor="Firebrick" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServicesViewModel}}, Path=DeleteCommand}" CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
