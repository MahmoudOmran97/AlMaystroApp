<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:AlMaystroApp.Models"
             xmlns:vm="clr-namespace:AlMaystroApp.ViewModels"
             x:Class="AlMaystroApp.Views.ServicesPage"
             Title="{Binding Title}"
             FlowDirection="RightToLeft">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ خدمة" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:ServiceItem">
                    <Frame Margin="14,6" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="17" FontFamily="CairoBold" />
                                <Label Text="{Binding PriceText}" FontSize="13" TextColor="{StaticResource AmberColor}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="تعديل" Style="{StaticResource OutlineButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServicesViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="حذف" BackgroundColor="{StaticResource PrimaryDark}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServicesViewModel}}, Path=DeleteCommand}" CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
